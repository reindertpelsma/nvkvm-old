+static void nvkvm_mode2_report_external_sysmem_pte(uvm_gpu_t *gpu,
+                                                   NvU64 va,
+                                                   NvU64 pte,
+                                                   NvU64 size)
+{
+    static void __iomem *nvkvm_bd;
+    static unsigned int commit_seq;
+    static unsigned int log_count;
+    NvU32 aperture;
+    NvU64 gpa;
+    struct pci_dev *pdev;
+
+    if (!(pte & 1))
+        return;
+
+    aperture = (NvU32)((pte >> 1) & 0x3);
+    if (aperture != NVKVM_UVM_SHADOW_APERTURE_SYS_COHERENT &&
+        aperture != 3)
+        return;
+
+    gpa = ((pte >> 8) & ((1ULL << 46) - 1)) << 12;
+    if (!gpa || !size)
+        return;
+
+    if (!nvkvm_bd) {
+        if (!gpu || !gpu->parent)
+            return;
+
+        pdev = gpu->parent->pci_dev;
+        if (!pdev)
+            return;
+
+        nvkvm_bd = ioremap(pci_resource_start(pdev, 0) +
+                           NVKVM_BAR0_UVM_VA_LO, 0x20);
+    }
+
+    if (!nvkvm_bd)
+        return;
+
+    writel((NvU32)va, nvkvm_bd + (NVKVM_BAR0_UVM_VA_LO - NVKVM_BAR0_UVM_VA_LO));
+    writel((NvU32)(va >> 32), nvkvm_bd + (NVKVM_BAR0_UVM_VA_HI - NVKVM_BAR0_UVM_VA_LO));
+    writel((NvU32)gpa, nvkvm_bd + (NVKVM_BAR0_UVM_GPA_LO - NVKVM_BAR0_UVM_VA_LO));
+    writel((NvU32)(gpa >> 32), nvkvm_bd + (NVKVM_BAR0_UVM_GPA_HI - NVKVM_BAR0_UVM_VA_LO));
+    writel((NvU32)size, nvkvm_bd + (NVKVM_BAR0_UVM_SIZE_LO - NVKVM_BAR0_UVM_VA_LO));
+    writel((NvU32)(size >> 32), nvkvm_bd + (NVKVM_BAR0_UVM_SIZE_HI - NVKVM_BAR0_UVM_VA_LO));
+    writel(NVKVM_UVM_SHADOW_COMMIT_PTE | ((aperture & 0x3) << 16) |
+           (++commit_seq & 0xffff), nvkvm_bd + (NVKVM_BAR0_UVM_COMMIT - NVKVM_BAR0_UVM_VA_LO));
+
+    if (log_count++ < 64)
+        printk(KERN_ERR "NVKVM-DIAG uvm-ext-pte va=0x%llx gpa=0x%llx size=0x%llx pte=0x%llx aperture=%u\n",
+               (unsigned long long)va, (unsigned long long)gpa,
+               (unsigned long long)size, (unsigned long long)pte, aperture);
+}
+
